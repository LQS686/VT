    <application
        android:name=".VtApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.VT">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Stub activities are manifest placeholders. At runtime the guest Activity class is
          instantiated instead by GuestRuntime (ActivityThread virtualization).
          Two process slots allow two guest apps to stay resident at the same time.
        -->
        <activity android:name="io.vt.container.stub.StubStandard0" android:exported="false"
            android:process=":g0" android:launchMode="standard"
            android:taskAffinity="io.vt.framework.guest0" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleTop0" android:exported="false"
            android:process=":g0" android:launchMode="singleTop"
            android:taskAffinity="io.vt.framework.guest0" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleTask0" android:exported="false"
            android:process=":g0" android:launchMode="singleTask"
            android:taskAffinity="io.vt.framework.guest0" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleInstance0" android:exported="false"
            android:process=":g0" android:launchMode="singleInstance"
            android:taskAffinity="io.vt.framework.guest0" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />

        <activity android:name="io.vt.container.stub.StubStandard1" android:exported="false"
            android:process=":g1" android:launchMode="standard"
            android:taskAffinity="io.vt.framework.guest1" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleTop1" android:exported="false"
            android:process=":g1" android:launchMode="singleTop"
            android:taskAffinity="io.vt.framework.guest1" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleTask1" android:exported="false"
            android:process=":g1" android:launchMode="singleTask"
            android:taskAffinity="io.vt.framework.guest1" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity android:name="io.vt.container.stub.StubSingleInstance1" android:exported="false"
            android:process=":g1" android:launchMode="singleInstance"
            android:taskAffinity="io.vt.framework.guest1" android:theme="@style/Theme.VT.Stub"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />

        <receiver android:name="io.vt.container.runtime.ControlReceiver0"
            android:exported="false" android:process=":g0" />
        <receiver android:name="io.vt.container.runtime.ControlReceiver1"
            android:exported="false" android:process=":g1" />

        <service android:name="io.vt.container.stub.StubGuestService0"
            android:exported="false" android:process=":g0" />
        <service android:name="io.vt.container.stub.StubGuestService1"
            android:exported="false" android:process=":g1" />
    </application>
</manifest>
